# Where the FastAPI backend runs
BACKEND_URL=http://127.0.0.1:8000

# Same value as ADMIN_API_KEY in backend/.env. Only the Next.js server sees it; the browser never does.
ADMIN_API_KEY=

# What you type on the login page
DASHBOARD_PASSWORD=

# Signs the login cookie. Any long random string.
SESSION_SECRET=

# Optional. A PUBLIC Mapbox token (it starts with pk.) switches the Map page from the simple drawn map to live Mapbox tiles.
# Restrict it to your site's address in the Mapbox account. Never put a secret (sk.) token here: this value is sent to the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Buyer accounts (Supabase Auth) ---
# Project URL and the public (anon / publishable) key from Supabase > Project Settings > API. Both are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The one account that gets the Command Center instead of the Client Portal. Create it in Supabase and confirm its email.
# Keep "Confirm email" switched on in Supabase Auth, or anyone could sign up with this address first.
BROKER_EMAIL=
