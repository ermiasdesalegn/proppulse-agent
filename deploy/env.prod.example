# Copy to deploy/.env.prod (gitignored) and fill in. Read by deploy/gcp.sh and deploy/scheduler.sh.
GCP_PROJECT=
GCP_REGION=europe-west1
SERVICE=proppulse-backend
ALWAYS_ON=false

# Supabase production project. DATABASE_URL must be the SESSION POOLER string (Connect > Session pooler, port 5432):
# Cloud Run has no IPv6, and the direct connection host is IPv6 only on new projects.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
RESEND_API_KEY=
EMAIL_FROM=

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
CRON_SECRET=
# Encrypts each agency's stored bot token and calendar key. Generate with: python -m scripts.make_master_key. Keep it out of the database and git.
SECRETS_MASTER_KEY=
INGEST_WEBHOOK_SECRET=

# The public https address of this backend (the Telegram webhook is registered from it) and the Vercel address of the dashboard (CORS, invitation links).
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=
TIMEZONE=Africa/Addis_Ababa

# Optional live integrations. GOOGLE_SERVICE_ACCOUNT_JSON holds the JSON itself (not a path).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
MAPBOX_TOKEN=
OFFICE_LAT=
OFFICE_LNG=

# Deal documents (contracts, receipts): a PRIVATE Supabase Storage bucket; needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above. Empty = uploads are refused.
DEAL_DOCUMENTS_BUCKET=

# Optional, with defaults. Job workers run inside the app (0 turns them off); prices are dollars per million tokens, "model=input/output", and are estimates.
# Audit trail export: a directory (development) or an object-lock S3 bucket (needs boto3 on the host). Both empty = off.
JOB_WORKERS=2
# MODEL_PRICES=default=0.30/2.50   (leave unset to use the built-in estimates; an empty value would replace them)
AUDIT_EXPORT_DIR=
AUDIT_EXPORT_BUCKET=

# Leave false on any deployment that holds real conversations; true only for a demo-only environment.
DEMO_RESET_ENABLED=false
