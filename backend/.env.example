# PropPulse AI - backend settings. Never commit this file.

# --- Gemini (Google AI Studio). Single key, no rotation. ---
GEMINI_API_KEY=
# Optional: more keys, comma separated. When every model on one key is out of quota the next key takes over.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_RPM=14

# --- Supabase (new project). Settings > API, and Connect > Direct connection ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still signs sign-in tokens with the shared secret (Auth > JWT Keys > legacy secret). Newer projects need nothing here: tokens are checked against the public keys at SUPABASE_URL.
SUPABASE_JWT_SECRET=
DATABASE_URL=

# --- Telegram (create a new bot with BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=

# --- Resend (carried over from the previous project) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Internal secrets (generated for this project) ---
ADMIN_API_KEY=
CRON_SECRET=
INGEST_WEBHOOK_SECRET=
# Lets the dashboard start the portal crawl (fine-grained token, Actions read and write on ONE repo). Optional: scheduled crawls work without it.
GITHUB_TOKEN=
GITHUB_REPO=
FRONTEND_ORIGIN=http://localhost:3000

# --- Business settings ---
HIGH_VALUE_THRESHOLD_ETB=20000000
TIMEZONE=Africa/Addis_Ababa
CURRENCY=ETB
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
WORKING_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
SIMILARITY_THRESHOLD=0.64

DEMO_FALLBACK_EMAIL=
DEMO_FALLBACK_TELEGRAM_CHAT_ID=

# --- Live integrations (leave empty to use the built-in mocks) ---
# Service account JSON, or the path to it. Share the calendar with its client_email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
MAPBOX_TOKEN=
# Where tours start from; leave empty to start at the first stop.
OFFICE_LAT=
OFFICE_LNG=

# Lets the dashboard's "Reset demo" button wipe conversations and restore the demo catalogue. Leave false anywhere real data lives.
DEMO_RESET_ENABLED=false

# --- Operations ---
# text for a terminal, json for Cloud Logging. Both are redacted.
LOG_FORMAT=text
# true only behind a proxy you control (Cloud Run): then X-Forwarded-For names the client for rate limits.
TRUST_PROXY_HEADERS=false
